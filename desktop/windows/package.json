{
  "name": "dsh-whale-girl-pet-windows",
  "productName": "DS 鲸鱼娘桌宠",
  "version": "0.1.0",
  "description": "Windows 桌面外壳：把 DSH 里的鲸鱼娘桌宠放到桌面上（透明、置顶、点击穿透、贴边悬浮球）。她本身还是那份 DSH 插件，这里只是个窗口。",
  "main": "main.js",
  "author": "Andersen216",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.andersen216.dsh.whalegirlpet",
    "productName": "DS 鲸鱼娘桌宠",
    "files": [
      "main.js",
      "preload.js",
      "build/**"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DS 鲸鱼娘桌宠"
    },
    "artifactName": "DS-WhaleGirl-Pet-Windows-Setup.${ext}"
  }
}
